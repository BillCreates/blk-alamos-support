# Diese Datei kann lokal direkt genutzt oder in Unraid in den Container
# gemountet werden. Wenn du sie extern mountest, setze im Container:
# ENV_FILE=/config/problem-report.env

PORT=8080
TRUST_PROXY=1

# Optional: Browser-Origin whitelisten, wenn das Formular nicht direkt
# ueber denselben Host wie das Backend ausgeliefert wird.
# Beispiel: https://formular.example.de
ALLOWED_ORIGINS=https://formular.example.de

# Fuer Produktion hinter Reverse Proxy erforderlich.
PROXY_SHARED_SECRET=change-me

# Nur fuer lokale Direktzugriffe ohne Reverse Proxy aktivieren.
# In Produktion leer lassen oder weglassen.
# ALLOW_DIRECT_POST_ACCESS=1

# Ziel fuer die Weiterleitung an deine bestehende n8n-Instanz
N8N_WEBHOOK_URL=https://n8n.example.de/webhook/support-form
N8N_WEBHOOK_SECRET=change-me

# Sichtbarer Text der Sicherheitsfrage
GATE_QUESTION=Was bedeutet die Abkuerzung ELW?
GATE_LABEL=Antwort
GATE_PLACEHOLDER=Antwort eingeben

# Entweder die erwartete Antwort im Klartext setzen ...
GATE_EXPECTED_ANSWER=Einsatzleitwagen

# ... oder alternativ nur den Hash verwenden.
# GATE_ANSWER_HASH=

# Formularoptionen
ALLOWED_DISTRICTS=Löschbezirk 1,Löschbezirk 2,Löschbezirk 3,Löschbezirk 4
ALLOWED_CATEGORIES=Zugang / Login,Softwarefehler,Datenproblem,Bedienung / Frage,Sonstiges

# Session-Laufzeit fuer erfolgreich bestandene Sicherheitsfrage
SESSION_TTL_MS=14400000

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_GATE_WINDOW_MS=600000
RATE_LIMIT_GATE_MAX_REQUESTS=10
JSON_LIMIT=20kb
