# Produktions-Env fuer Docker Desktop auf Windows hinter Reverse Proxy
#
# Diese Datei ist fuer einen produktionsartigen Betrieb gedacht.
# Sie nutzt keinen Direktzugriff und erwartet einen vorgeschalteten Reverse Proxy,
# der den Header X-Proxy-Shared-Secret an das Backend weitergibt.

PORT=8080
TRUST_PROXY=1

# Echte oeffentliche Formular-Domain
ALLOWED_ORIGINS=https://meldung.alamos-blieskastel.ipv64.net

# Muss identisch im Reverse Proxy als Header X-Proxy-Shared-Secret gesetzt werden
PROXY_SHARED_SECRET=replace-with-a-long-random-secret

# Ziel fuer das Backend
N8N_WEBHOOK_URL=https://n8n.example.de/webhook/support-form
N8N_WEBHOOK_SECRET=replace-with-a-second-long-random-secret

# Sichtbarer Fragetext im Formular
GATE_QUESTION=Was bedeutet die Abkuerzung ELW?
GATE_LABEL=Antwort
GATE_PLACEHOLDER=Antwort eingeben

# Entweder Klartext-Antwort setzen ...
GATE_EXPECTED_ANSWER=Einsatzleitwagen

# ... oder alternativ die obige Zeile weglassen und nur einen Hash setzen
# GATE_ANSWER_HASH=

# Laufzeiten und Limits
SESSION_TTL_MS=14400000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_GATE_WINDOW_MS=600000
RATE_LIMIT_GATE_MAX_REQUESTS=10
JSON_LIMIT=20kb
